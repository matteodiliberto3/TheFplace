{
  "name": "thehustleplace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev -p 3005",
    "start:e2e": "next start -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "npm run build && node scripts/e2e-prod.mjs",
